{
  "name": "fly-poker",
  "compatibility_date": "2026-09-13",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "fly-poker.piphipsi.com",
      "custom_domain": true,
      "zone_name": "piphipsi.com"
    }
  ],
  "assets": {
    "directory": ".cloudflare/public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
